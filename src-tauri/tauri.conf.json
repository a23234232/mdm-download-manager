{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDM",
  "version": "0.1.0",
  "identifier": "com.mdm.downloadmanager",
  "build": {
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [
      {
        "title": "MDM",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "backgroundColor": "#090b10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../extension",
      "../docs"
    ]
  }
}
